-- Kapanma animasyonu (küçülerek yok olma)
local function KapatAnimasyon()
    local tween = TweenService:Create(AnaFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundTransparency = 1
    })
    tween:Play()
    
    for _, obj in pairs(AnaFrame:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            TweenService:Create(obj, TweenInfo.new(0.3), {TextTransparency = 1, BackgroundTransparency = 1}):Play()
        elseif obj:IsA("UIStroke") then
            TweenService:Create(obj, TweenInfo.new(0.3), {Transparency = 1}):Play()
        end
    end
    
    task.wait(0.5)
    AnaFrame.Visible = false
    -- Sıfırla
    AnaFrame.Size = UDim2.new(0, 420, 0, 480)
    AnaFrame.BackgroundTransparency = 0
    for _, obj in pairs(AnaFrame:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            obj.TextTransparency = 0
        elseif obj:IsA("UIStroke") then
            obj.Transparency = 0
        end
    end
end

-- Açılma animasyonu (büyüyerek açılma)
local function AcAnimasyon()
    AnaFrame.Visible = true
    AnaFrame.Size = UDim2.new(0, 0, 0, 0)
    AnaFrame.BackgroundTransparency = 1
    
    for _, obj in pairs(AnaFrame:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            if obj ~= AnaFrame then obj.TextTransparency = 1 end
        elseif obj:IsA("UIStroke") then
            obj.Transparency = 1
        end
    end
    
    local tween = TweenService:Create(AnaFrame, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 420, 0, 480),
        BackgroundTransparency = 0
    })
    tween:Play()
    
    task.wait(0.3)
    
    for _, obj in pairs(AnaFrame:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            TweenService:Create(obj, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
        elseif obj:IsA("UIStroke") then
            TweenService:Create(obj, TweenInfo.new(0.3), {Transparency = 0}):Play()
        end
    end
end

