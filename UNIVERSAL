        Size = UDim2.new(0, 70, 0, 70)
    }):Play()
    
    task.wait(0.3)
    TweenService:Create(TopLabel, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
    
    -- Nabız animasyonu (sürekli)
    task.spawn(function()
        while TopAnimasyonAktif and YuzuyorTop and YuzuyorTop.Parent do
            local pulse = TweenService:Create(YuzuyorTop, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
