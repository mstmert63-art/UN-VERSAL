-- ============================================
-- YAPAY ZEKA HİLE SENTEZLEYİCİ (Kural Tabanlı AI)
-- ============================================
-- Bu AI, kullanıcının yazdığı metni analiz eder,
-- anahtar kelimeleri çıkarır, hangi hile türü olduğunu
-- anlar ve uygun kodu otomatik olarak üretir/çalıştırır.

local AI = {}
AI.__index = AI

function AI.new()
    local self = setmetatable({}, AI)
    self.aktifHileler = {}
    self.baglantilar = {}
    self.olusturulanKod = ""
    return self
end

-- Metin analiz fonksiyonu (NLP basit)
function AI:MetniAnalizEt(metin)
    local analiz = {
        orijinal = metin,
        kucuk = string.lower(metin),
        kelimeler = {},
        hileTuru = "bilinmiyor",
        guvenSkoru = 0,
        parametreler = {}
    }
    
    -- Kelimelere ayır
    for kelime in string.gmatch(analiz.kucuk, "%a+") do
        table.insert(analiz.kelimeler, kelime)
    end
    
    -- Hile türü tespiti (genişletilmiş anahtar kelime havuzu)
    local hileSozlugu = {
        fly = {"fly", "uç", "uc", "uçmak", "flight", "hover", "süzül"},
        esp = {"esp", "wall", "duvar", "gör", "gor", "xray", "x-ray", "outline", "çerçeve", "cerceve"},
        speed = {"speed", "hız", "hiz", "hızlı", "hizli", "fast", "koş", "kos", "sprint"},
        jump = {"jump", "zıpla", "zipla", "infinity", "sonsuz", "ziplama", "hop"},
        noclip = {"noclip", "no clip", "duvar geç", "duvardan", "clip", "geçir", "gecir"},
        godmode = {"god", "ölümsüz", "olumsuz", "tanrı", "tanri", "sonsuz can", "inf health"},
        teleport = {"tp", "teleport", "ışınlan", "isinlan", "git", "koordinat", "position"},
        aimbot = {"aim", "aimbot", "nişan", "nisan", "hedef", "kilit", "lock"},
        autofarm = {"farm", "oto", "auto", "otomatik", "kasma", "para", "cash", "money"},
        infiniteammo = {"ammo", "mermi", "sonsuz mermi", "inf ammo", "reload"},
        fullbright = {"bright", "aydınlat", "aydinlat", "ışık", "isik", "gece", "night", "fullbright"},
        hitbox = {"hitbox", "vuruş", "vurus", "kutu", "geniş", "genis"},
        flycar = {"araç uçur", "arac ucur", "car fly", "vehicle"},
        silahisınla = {"silah", "silah ışınla", "silah isinla", "weapon tp", "weapon teleport"},
        nuke = {"nuke", "patlat", "bomba", "patlama", "explosion"},
        troll = {"troll", "rahatsız", "rahatsiz", "fling", "fırlat", "firlat"},
        invisible = {"görünmez", "gorunmez", "invisible", "gizlen", "saklan"},
        flyall = {"herkesi uçur", "tüm oyuncular", "all fly", "everyone"},
    }
    
    for tur, anahtarlar in pairs(hileSozlugu) do
        for _, anahtar in ipairs(anahtarlar) do
            if string.find(analiz.kucuk, anahtar, 1, true) then
                analiz.hileTuru = tur
                analiz.guvenSkoru = analiz.guvenSkoru + 1
            end
        end
    end
    
    -- Sayı parametrelerini çıkar (örn: speed 100)
    for sayi in string.gmatch(analiz.kucuk, "%d+") do
        table.insert(analiz.parametreler, tonumber(sayi))
    end
    
    return analiz
end

-- AI Kod Üretici - her hile türü için kod bloğu üretir
function AI:KodUret(analiz)
    local tur = analiz.hileTuru
    local kod = "-- AI tarafından üretildi: " .. tur .. "\n"
    
    if tur == "fly" then
        kod = kod .. [[
-- Fly hilesi üretildi
local flyVel = Instance.new("BodyVelocity")
flyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
flyVel.Velocity = Vector3.new(0,0,0)
flyVel.Name = "AI_FlyVel"
flyVel.Parent = RootPart
local flyGyro = Instance.new("BodyGyro")
flyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
flyGyro.P = 1000
flyGyro.Name = "AI_FlyGyro"
flyGyro.Parent = RootPart
]] 
    elseif tur == "esp" then
        kod = kod .. [[
-- ESP hilesi üretildi
for _, p in pairs(Players:GetPlayers()) do
    if p ~= LocalPlayer and p.Character then
        local h = Instance.new("Highlight")
        h.FillColor = Color3.fromRGB(255,0,0)
        h.OutlineColor = Color3.fromRGB(255,255,255)
        h.Name = "AI_ESP"
        h.Parent = p.Character
    end
end
]]
    elseif tur == "speed" then
        kod = kod .. "-- Speed hilesi üretildi\nHumanoid.WalkSpeed = " .. (analiz.parametreler[1] or 100) .. "\n"
    elseif tur == "jump" then
        kod = kod .. "-- Infinity Jump üretildi\nHumanoid.UseJumpPower = true\nHumanoid.JumpPower = 150\n"
    elseif tur == "noclip" then
        kod = kod .. [[
-- Noclip üretildi
for _, p in pairs(Character:GetDescendants()) do
    if p:IsA("BasePart") then p.CanCollide = false end
end
]]
    elseif tur == "godmode" then
        kod = kod .. "-- God Mode üretildi\nHumanoid.MaxHealth = math.huge\nHumanoid.Health = math.huge\n"
    elseif tur == "teleport" then
        kod = kod .. "-- Teleport üretildi (mouse pozisyonu)\nlocal m = LocalPlayer:GetMouse()\nif m.Hit then RootPart.CFrame = CFrame.new(m.Hit.Position + Vector3.new(0,5,0)) end\n"
    elseif tur == "fullbright" then
        kod = kod .. [[
-- Fullbright üretildi
Lighting.Brightness = 3
Lighting.ClockTime = 12
Lighting.FogEnd = 100000
Lighting.GlobalShadows = false
]]
    elseif tur == "invisible" then
        kod = kod .. [[
-- Görünmezlik üretildi
for _, p in pairs(Character:GetDescendants()) do
    if p:IsA("BasePart") then p.Transparency = 1 end
    if p:IsA("Decal") then p.Transparency = 1 end
end
]]
    elseif tur == "silahisınla" then
        kod = kod .. [[
-- Silah ışınlama üretildi
for _, obj in pairs(workspace:GetDescendants()) do
    if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
        obj.Handle.CFrame = RootPart.CFrame
    end
end
]]
    else
        kod = kod .. "-- Genel amaçlı hile kod şablonu (AI sentezledi)\nprint('AI hile: " .. tur .. "')"
    end
    
    return kod
end

-- AI Çalıştırıcı - üretilen kodu çalıştırır
function AI:Calistir(analiz)
    local tur = analiz.hileTuru
    local sonuc = ""
    
    -- Aktif değilse aktif et, aktifse deaktif et
    local aktifMi = self.aktifHileler[tur]
    
    if tur == "fly" then
        if not aktifMi then
            self.aktifHileler[tur] = true
            local flyVel = Instance.new("BodyVelocity")
            flyVel.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            flyVel.Velocity = Vector3.new(0,0,0)
            flyVel.Name = "AI_FlyVel"
            flyVel.Parent = RootPart
            local flyGyro = Instance.new("BodyGyro")
            flyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            flyGyro.P = 1000
            flyGyro.Name = "AI_FlyGyro"
            flyGyro.Parent = RootPart
            
            self.baglantilar[tur] = RunService.RenderStepped:Connect(function()
                if not self.aktifHileler[tur] then return end
                local kam = workspace.CurrentCamera
                local yon = Vector3.new(0,0,0)
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then yon = yon + kam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then yon = yon - kam.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then yon = yon - kam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then yon = yon + kam.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then yon = yon + Vector3.new(0,1,0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then yon = yon - Vector3.new(0,1,0) end
                if RootPart:FindFirstChild("AI_FlyVel") then
                    RootPart.AI_FlyVel.Velocity = yon.Magnitude > 0 and yon.Unit * 60 or Vector3.new(0,0,0)
                end
                if RootPart:FindFirstChild("AI_FlyGyro") then
                    RootPart.AI_FlyGyro.CFrame = kam.CFrame
                end
            end)
            sonuc = "✅ FLY aktif! WASD + Space/Shift"
        else
            self.aktifHileler[tur] = false
            if self.baglantilar[tur] then self.baglantilar[tur]:Disconnect() end
            if RootPart:FindFirstChild("AI_FlyVel") then RootPart.AI_FlyVel:Destroy() end
            if RootPart:FindFirstChild("AI_FlyGyro") then RootPart.AI_FlyGyro:Destroy() end
            sonuc = "❌ FLY deaktif"
        end
    elseif tur == "esp" then
        if not aktifMi then
            self.aktifHileler[tur] = true
            self.baglantilar[tur] = RunService.Heartbeat:Connect(function()
                if not self.aktifHileler[tur] then return end
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and not p.Character:FindFirstChild("AI_ESP") then
                        local h = Instance.new("Highlight")
                        h.FillColor = Color3.fromRGB(255,0,0)
                        h.OutlineColor = Color3.fromRGB(255,255,255)
                        h.Name = "AI_ESP"
                        h.Parent = p.Character
                    end
                end
            end)
            sonuc = "✅ ESP aktif! Tüm oyuncular işaretlendi"
        else
            self.aktifHileler[tur] = false
            if self.baglantilar[tur] then self.baglantilar[tur]:Disconnect() end
            for _, p in pairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("AI_ESP") then
                    p.Character.AI_ESP:Destroy()
                end
            end
            sonuc = "❌ ESP deaktif"
        end
    elseif tur == "speed" then
        if not aktifMi then
            self.aktifHileler[tur] = true
            Humanoid.WalkSpeed = analiz.parametreler[1] or 100
            sonuc = "✅ SPEED aktif! Hız: " .. Humanoid.WalkSpeed
        else
            self.aktifHileler[tur] = false
            Humanoid.WalkSpeed = 16
            sonuc = "❌ SPEED deaktif"
        end
    elseif tur == "jump" then
        if not aktifMi then
            self.aktifHileler[tur] = true
            Humanoid.UseJumpPower = true
            Humanoid.JumpPower = 150
            self.baglantilar[tur] = Humanoid.StateChanged:Connect(function(o, n)
                if self.aktifHileler[tur] and n == Enum.HumanoidStateType.Landed then
                    Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                end
            end)
            sonuc = "✅ INFINITY JUMP aktif!"
        else
            self.aktifHileler[tur] = false
            if self.baglantilar[tur] then self.baglantilar[tur]:Disconnect() end
            Humanoid.JumpPower = 50
            sonuc = "❌ INFINITY JUMP deaktif"
        end
    elseif tur == "noclip" then
        if not aktifMi then
            self.aktifHileler[tur] = true
            self.baglantilar[tur] = RunService.Stepped:Connect(function()
                if not self.aktifHileler[tur] then return end
                for _, p in pairs(Character:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end)
            sonuc = "✅ NOCLIP aktif!"
        else
            self.aktifHileler[tur] = false
            if self.baglantilar[tur] then self.baglantilar[tur]:Disconnect() end
            for _, p in pairs(Character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = true end
            end
            sonuc = "❌ NOCLIP deaktif"
        end
    elseif tur == "godmode" then
        if not aktifMi then
            self.aktifHileler[tur] = true
            Humanoid.MaxHealth = math.huge
            Humanoid.Health = math.huge
            sonuc = "✅ GOD MODE aktif!"
        else
            self.aktifHileler[tur] = false
            Humanoid.MaxHealth = 100
            Humanoid.Health = 100
            sonuc = "❌ GOD MODE deaktif"
        end
    elseif tur == "teleport" then
        local mouse = LocalPlayer:GetMouse()
        if mouse.Hit then
            RootPart.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0,5,0))
            sonuc = "✅ TELEPORT: Mouse pozisyonuna ışınlandın"
        else
            sonuc = "⚠️ Mouse hedefi yok"
        end
    elseif tur == "fullbright" then
        if not aktifMi then
            self.aktifHileler[tur] = true
            Lighting.Brightness = 3
            Lighting.ClockTime = 12
            Lighting.FogEnd = 100000
            Lighting.GlobalShadows = false
            sonuc = "✅ FULLBRIGHT aktif!"
        else
            self.aktifHileler[tur] = false
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.FogEnd = 100000
            Lighting.GlobalShadows = true
            sonuc = "❌ FULLBRIGHT deaktif"
        end
    elseif tur == "invisible" then
        if not aktifMi then
            self.aktifHileler[tur] = true
            for _, p in pairs(Character:GetDescendants()) do
                if p:IsA("BasePart") then p.Transparency = 1 end
                if p:IsA("Decal") then p.Transparency = 1 end
            end
            sonuc = "✅ GÖRÜNMEZLİK aktif!"
        else
            self.aktifHileler[tur] = false
            for _, p in pairs(Character:GetDescendants()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.Transparency = 0 end
                if p:IsA("Decal") then p.Transparency = 0 end
            end
            sonuc = "❌ GÖRÜNMEZLİK deaktif"
        end
    elseif tur == "silahisınla" then
        local sayi = 0
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                obj.Handle.CFrame = RootPart.CFrame * CFrame.new(0, 0, -3)
                sayi = sayi + 1
            end
        end
        sonuc = "✅ SİLAH IŞINLAMA: " .. sayi .. " silah çekildi"
    else
        sonuc = "⚠️ AI hile türünü tam algılayamadı, genel mod çalıştırıldı"
    end
    
    return sonuc, self:KodUret(analiz)
end

