                Size = UDim2.new(0, 0, 0, 0)
            }):Play()
            task.wait(0.3)
            if YuzuyorTop then YuzuyorTop:Destroy() YuzuyorTop = nil end
            TopAnimasyonAktif = false
            -- Menüyü aç
            AcAnimasyon()
        end
    end)
end

